# Leave MONGODB_URI empty to use the built-in JSON-file store (works out of the box).
# Point it at a real cluster to switch to MongoDB Atlas -- no code changes needed.
MONGODB_URI=

# Leave AI_API_KEY empty to run in AI SIMULATION MODE (deterministic mock, clearly
# labeled in the UI). Set it to a real Anthropic API key to enable real AI analysis.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_PROVIDER=anthropic

FRONTEND_URL=http://localhost:5173
